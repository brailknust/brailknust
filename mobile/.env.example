# Same Supabase project as the web app (see ../.env.example)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the BRAIL Next.js API this app talks to.
# Local dev: http://localhost:3000  (use your LAN IP, not localhost, for a
# physical device — e.g. http://192.168.1.20:3000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
