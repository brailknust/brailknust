# Use a disposable Supabase project or the local Supabase CLI stack only.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider settings. Browser tests do not require a real AI key.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_DAILY_MESSAGE_LIMIT=20

# Explicitly set to 1 only for a disposable remote test project.
E2E_ALLOW_REMOTE=0
