generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SemesterTerm {
  FIRST
  SECOND
}

enum EnrollmentOrigin {
  CURRICULUM_DEFAULT
  MANUAL
  TRANSFER
  REPEAT
}

enum AcademicLevel {
  LEVEL_100
  LEVEL_200
  LEVEL_300
  LEVEL_400
  LEVEL_500
  LEVEL_600
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  EXPIRED
  ARCHIVED
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ResourceType {
  NOTE
  SLIDE
  PAST_QUESTION
  LINK
  OTHER
}

enum MaterialStatus {
  PENDING
  READY
  FAILED
  ARCHIVED
}

enum DiagnosticStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum AiUsageOperation {
  CHAT
  DIAGNOSTIC
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum NotificationType {
  DEADLINE
  STUDY_PLAN
  GROUP
  SYSTEM
}

enum NotificationStatus {
  PENDING
  DELIVERED
  READ
  DISMISSED
  EXPIRED
  FAILED
}

enum NotificationChannel {
  IN_APP
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  LAB
  PROJECT
  MIDSEM
  EXAM
  OTHER
}

enum GoalCategory {
  ACADEMIC
  STUDY_TIME
  COURSE_MASTERY
  TASKS
  PERSONAL
}

enum GoalMetric {
  MANUAL
  CWA
  STUDY_MINUTES
  TASKS_COMPLETED
  ASSESSMENT_AVERAGE
  COURSE_MASTERY
  QUESTIONS_COMPLETED
}

enum GoalPeriod {
  SEMESTER
  WEEKLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  MISSED
  PAUSED
  ARCHIVED
}

enum GoalType {
  ACADEMIC_CWA
  COURSE_STUDY_TIME
  COURSE_MASTERY
  PRACTICE_QUESTIONS
  MANUAL_CHECKLIST
}

enum GoalTargetUnit {
  PERCENT
  MINUTES
  QUESTIONS
  COUNT
  MANUAL
}

enum GoalTrackingSource {
  ACADEMIC_RECORDS
  PLANNER_SESSIONS
  QUIZZES_AND_ASSESSMENTS
  PRACTICE_ATTEMPTS
  MANUAL
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum UserRole {
  STUDENT
  ADMIN
}

enum AdminRoleAction {
  BOOTSTRAPPED
  GRANTED
  REVOKED
}

enum CourseApprovalStatus {
  OFFICIAL
  PENDING
  REJECTED
}

enum PlatformMaterialStatus {
  PUBLISHED
  ARCHIVED
  FAILED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum FeedbackType {
  BUG
  IDEA
  PRAISE
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  PLANNED
  CLOSED
}

enum CurriculumImportStatus {
  DRAFT
  APPLIED
  ROLLED_BACK
}

enum CurriculumImportRowStatus {
  VALID
  INVALID
  APPLIED
}

model User {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId                String                     @unique @map("auth_user_id") @db.Uuid
  email                     String                     @unique
  role                      UserRole                   @default(STUDENT)
  fullName                  String                     @map("full_name")
  studentId                 String?                    @unique @map("student_id")
  college                   String?
  programme                 String?
  department                String?
  level                     AcademicLevel?
  cwa                       Decimal?                   @db.Decimal(5, 2)
  activeSemesterId          String?                    @map("active_semester_id") @db.Uuid
  avatarUrl                 String?                    @map("avatar_url")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  deletionStoragePaths      Json?                      @map("deletion_storage_paths")
  deletionStoragePending    Boolean                    @default(false) @map("deletion_storage_pending")
  deletionAuthPending       Boolean                    @default(false) @map("deletion_auth_pending")
  deletionAttempts          Int                        @default(0) @map("deletion_attempts")
  deletionLastError         String?                    @map("deletion_last_error")
  deletionCompletedAt       DateTime?                  @map("deletion_completed_at")
  activeSemester            Semester?                  @relation("UserActiveSemester", fields: [activeSemesterId], references: [id])
  aiConversations           AiConversation[]
  aiUsageEvents             AiUsageEvent[]
  assessments               Assessment[]
  cwaSnapshots              CwaSnapshot[]
  enrollments               Enrollment[]
  goals                     Goal[]
  goalProgressSnapshots     GoalProgressSnapshot[]
  groupsOwned               StudyGroup[]               @relation("StudyGroupOwner")
  memberships               StudyGroupMember[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  resources                 Resource[]
  courseMaterials           CourseMaterial[]
  diagnosticAttempts        DiagnosticAttempt[]
  diagnosticFeedback        DiagnosticFeedback[]
  diagnosticQuizzes         DiagnosticQuiz[]
  topicMasteries            TopicMastery[]
  semesterProfiles          SemesterProfile[]
  semestersOwned            Semester[]                 @relation("UserSemesters")
  studyPlans                StudyPlan[]
  tasks                     Task[]
  timetable                 TimetableBlock[]
  weakAreas                 WeakArea[]
  peerQuestions             PeerQuestion[]
  peerAnswers               PeerAnswer[]
  peerVotes                 PeerQuestionVote[]
  platformMaterials         PlatformCourseMaterial[]
  programmeCourseExclusions ProgrammeCourseExclusion[]
  studentCourseExclusions   StudentCourseExclusion[]
  adminRoleChangesMade      AdminRoleAudit[]           @relation("AdminRoleAuditActor")
  adminRoleChangesReceived  AdminRoleAudit[]           @relation("AdminRoleAuditTarget")
  coursesCreated            Course[]                   @relation("CourseCreator")
  supportRequests           SupportRequest[]
  feedback                  Feedback[]
  curriculumImports         CurriculumImport[]

  @@index([activeSemesterId])
  @@index([deletedAt])
  @@index([deletionStoragePending, deletionAuthPending])
  @@map("users")
}

model SupportRequest {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  subject   String
  message   String
  status    SupportRequestStatus @default(OPEN)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("support_requests")
}

model Feedback {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      FeedbackType   @default(OTHER)
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("feedback")
}

model AdminRoleAudit {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?         @map("actor_id") @db.Uuid
  targetUserId String          @map("target_user_id") @db.Uuid
  action       AdminRoleAction
  createdAt    DateTime        @default(now()) @map("created_at")
  actor        User?           @relation("AdminRoleAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User            @relation("AdminRoleAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorId])
  @@map("admin_role_audits")
}

model Course {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                   @unique
  name              String
  creditHours       Int?                     @map("credit_hours")
  department        String?
  level             AcademicLevel?
  description       String?
  approvalStatus    CourseApprovalStatus     @default(PENDING) @map("approval_status")
  createdById       String?                  @map("created_by_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  createdBy         User?                    @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assessments       Assessment[]
  enrollments       Enrollment[]
  goals             Goal[]
  groups            StudyGroup[]
  resources         Resource[]
  studyItems        StudyPlanItem[]
  tasks             Task[]
  timetable         TimetableBlock[]
  weakAreas         WeakArea[]
  peerQuestions     PeerQuestion[]
  platformMaterials PlatformCourseMaterial[]
  platformTopics    PlatformCourseTopic[]

  @@index([approvalStatus, createdById])
  @@map("courses")
}

model Semester {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId               String                   @map("owner_id") @db.Uuid
  level                 AcademicLevel
  term                  SemesterTerm
  name                  String
  academicYear          String                   @map("academic_year")
  cwa                   Decimal?                 @db.Decimal(5, 2)
  startDate             DateTime?                @map("start_date") @db.Date
  endDate               DateTime?                @map("end_date") @db.Date
  isActive              Boolean                  @default(false) @map("is_active")
  isArchived            Boolean                  @default(false) @map("is_archived")
  isCustom              Boolean                  @default(false) @map("is_custom")
  provisionKey          String?                  @map("provision_key")
  curriculumId          String?                  @map("curriculum_id") @db.Uuid
  curriculumTermId      String?                  @map("curriculum_term_id") @db.Uuid
  archivedAt            DateTime?                @map("archived_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  owner                 User                     @relation("UserSemesters", fields: [ownerId], references: [id], onDelete: Cascade)
  curriculum            ProgrammeCurriculum?     @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  curriculumTerm        ProgrammeCurriculumTerm? @relation(fields: [curriculumTermId], references: [id], onDelete: SetNull)
  assessments           Assessment[]
  cwaSnapshots          CwaSnapshot[]
  activeUsers           User[]                   @relation("UserActiveSemester")
  aiConversations       AiConversation[]
  enrollments           Enrollment[]
  courseExclusions      StudentCourseExclusion[]
  goals                 Goal[]
  goalProgressSnapshots GoalProgressSnapshot[]
  aiUsageEvents         AiUsageEvent[]
  groups                StudyGroup[]
  profiles              SemesterProfile[]
  studyPlans            StudyPlan[]
  tasks                 Task[]
  timetable             TimetableBlock[]
  weakAreas             WeakArea[]
  peerQuestions         PeerQuestion[]
  notifications         Notification[]

  @@unique([ownerId, provisionKey])
  @@index([ownerId])
  @@index([ownerId, isArchived])
  @@map("semesters")
}

model ProgrammeCurriculum {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  college       String
  department    String
  programme     String
  version       String
  durationYears Int                       @map("duration_years")
  termsPerYear  Int                       @map("terms_per_year")
  source        String?
  isPublished   Boolean                   @default(true) @map("is_published")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  terms         ProgrammeCurriculumTerm[]
  semesters     Semester[]
  importedFrom  CurriculumImport?

  @@unique([college, programme, version])
  @@index([programme, version, isPublished])
  @@map("programme_curricula")
}

model CurriculumImport {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById    String                  @map("created_by_id") @db.Uuid
  college        String
  department     String
  programme      String
  version        String
  durationYears  Int                     @map("duration_years")
  termsPerYear   Int                     @map("terms_per_year")
  source         String?
  status         CurriculumImportStatus  @default(DRAFT)
  curriculumId   String?                 @unique @map("curriculum_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  appliedAt      DateTime?               @map("applied_at")
  rolledBackAt   DateTime?               @map("rolled_back_at")
  createdBy      User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  curriculum     ProgrammeCurriculum?    @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  rows           CurriculumImportRow[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@map("curriculum_imports")
}

model CurriculumImportRow {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId    String                    @map("import_id") @db.Uuid
  rowNumber   Int                       @map("row_number")
  courseCode  String?                   @map("course_code")
  courseName  String?                   @map("course_name")
  creditHours Int?                      @map("credit_hours")
  level       AcademicLevel?
  term        SemesterTerm?
  status      CurriculumImportRowStatus @default(VALID)
  error       String?
  import      CurriculumImport          @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("curriculum_import_rows")
}

model ProgrammeCurriculumTerm {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumId String                      @map("curriculum_id") @db.Uuid
  level        AcademicLevel
  term         SemesterTerm
  name         String
  source       String?
  createdAt    DateTime                    @default(now()) @map("created_at")
  curriculum   ProgrammeCurriculum         @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  courses      ProgrammeCurriculumCourse[]
  semesters    Semester[]

  @@unique([curriculumId, level, term])
  @@map("programme_curriculum_terms")
}

model ProgrammeCurriculumCourse {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumTermId String                  @map("curriculum_term_id") @db.Uuid
  courseCode       String                  @map("course_code")
  courseName       String                  @map("course_name")
  creditHours      Int                     @map("credit_hours")
  isApproved       Boolean                 @default(false) @map("is_approved")
  source           String?
  createdAt        DateTime                @default(now()) @map("created_at")
  curriculumTerm   ProgrammeCurriculumTerm @relation(fields: [curriculumTermId], references: [id], onDelete: Cascade)

  @@unique([curriculumTermId, courseCode])
  @@map("programme_curriculum_courses")
}

model SemesterProfile {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  semesterId String         @map("semester_id") @db.Uuid
  level      AcademicLevel?
  cwa        Decimal?       @db.Decimal(5, 2)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  semester   Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, semesterId])
  @@index([semesterId])
  @@map("semester_profiles")
}

model Enrollment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  courseId          String           @map("course_id") @db.Uuid
  semesterId        String           @map("semester_id") @db.Uuid
  lecturer          String?
  currentGrade      String?          @map("current_grade")
  attendance        Decimal?         @db.Decimal(5, 2)
  confidenceScore   Decimal?         @map("confidence_score") @db.Decimal(5, 2)
  origin            EnrollmentOrigin @default(MANUAL)
  sourceKey         String?          @map("source_key")
  createdAt         DateTime         @default(now()) @map("created_at")
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester          Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiConversations   AiConversation[]
  courseMaterials   CourseMaterial[]
  courseTopics      CourseTopic[]
  diagnosticQuizzes DiagnosticQuiz[]
  topicMasteries    TopicMastery[]

  @@unique([userId, courseId, semesterId])
  @@unique([userId, semesterId, sourceKey])
  @@index([courseId])
  @@index([semesterId])
  @@map("enrollments")
}

model StudentCourseExclusion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  courseCode String   @map("course_code")
  createdAt  DateTime @default(now()) @map("created_at")
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, semesterId, courseCode])
  @@map("student_course_exclusions")
}

model Assessment {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  semesterId String         @map("semester_id") @db.Uuid
  courseId   String         @map("course_id") @db.Uuid
  title      String
  type       AssessmentType @default(OTHER)
  score      Decimal        @db.Decimal(7, 2)
  maxScore   Decimal        @map("max_score") @db.Decimal(7, 2)
  weight     Decimal?       @db.Decimal(5, 2)
  assessedAt DateTime?      @map("assessed_at") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester   Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, courseId])
  @@index([semesterId])
  @@map("assessments")
}

model CwaSnapshot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  cwa        Decimal  @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, recordedAt])
  @@index([semesterId])
  @@map("cwa_snapshots")
}

model Goal {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  semesterId        String                 @map("semester_id") @db.Uuid
  courseId          String?                @map("course_id") @db.Uuid
  title             String
  goalType          GoalType               @default(MANUAL_CHECKLIST) @map("goal_type")
  category          GoalCategory
  metric            GoalMetric             @default(MANUAL)
  period            GoalPeriod             @default(SEMESTER)
  targetValue       Decimal                @map("target_value") @db.Decimal(10, 2)
  targetUnit        GoalTargetUnit         @default(MANUAL) @map("target_unit")
  trackingSource    GoalTrackingSource     @default(MANUAL) @map("tracking_source")
  currentValue      Decimal                @default(0) @map("current_value") @db.Decimal(10, 2)
  deadline          DateTime?              @db.Date
  startsAt          DateTime?              @map("starts_at") @db.Date
  status            GoalStatus             @default(ACTIVE)
  sourceKey         String?                @map("source_key")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  course            Course?                @relation(fields: [courseId], references: [id])
  semester          Semester               @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressSnapshots GoalProgressSnapshot[]

  @@unique([userId, semesterId, sourceKey])
  @@index([userId, semesterId, status])
  @@index([semesterId])
  @@index([courseId])
  @@map("goals")
}

model GoalProgressSnapshot {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  semesterId   String     @map("semester_id") @db.Uuid
  goalId       String     @map("goal_id") @db.Uuid
  metric       GoalMetric
  currentValue Decimal    @map("current_value") @db.Decimal(10, 2)
  targetValue  Decimal    @map("target_value") @db.Decimal(10, 2)
  progress     Int
  source       String     @default("computed")
  recordedAt   DateTime   @default(now()) @map("recorded_at")
  goal         Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  semester     Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
  @@index([userId, semesterId, recordedAt])
  @@map("goal_progress_snapshots")
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  courseId    String?      @map("course_id") @db.Uuid
  semesterId  String       @map("semester_id") @db.Uuid
  title       String
  description String?
  dueAt       DateTime?    @map("due_at")
  reminderAt  DateTime?    @map("reminder_at")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course?      @relation(fields: [courseId], references: [id])
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dueAt])
  @@index([reminderAt])
  @@index([userId, semesterId, status])
  @@index([semesterId])
  @@map("tasks")
}

model TimetableBlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  courseId   String?  @map("course_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week")
  startTime  DateTime @map("start_time") @db.Time
  endTime    DateTime @map("end_time") @db.Time
  venue      String?
  isBusy     Boolean  @default(true) @map("is_busy")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course?  @relation(fields: [courseId], references: [id])
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, dayOfWeek])
  @@index([semesterId])
  @@map("timetable_blocks")
}

model StudyPlan {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  semesterId    String          @map("semester_id") @db.Uuid
  title         String
  status        StudyPlanStatus @default(DRAFT)
  generatedByAi Boolean         @default(false) @map("generated_by_ai")
  startDate     DateTime?       @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  items         StudyPlanItem[]
  semester      Semester        @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, status])
  @@index([semesterId])
  @@map("study_plans")
}

model StudyPlanItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyPlanId     String     @map("study_plan_id") @db.Uuid
  courseId        String?    @map("course_id") @db.Uuid
  title           String
  scheduledStart  DateTime?  @map("scheduled_start")
  durationMinutes Int?       @map("duration_minutes")
  status          TaskStatus @default(TODO)
  aiReason        String?    @map("ai_reason")
