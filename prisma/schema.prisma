generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SemesterTerm {
  FIRST
  SECOND
}

enum AcademicLevel {
  LEVEL_100
  LEVEL_200
  LEVEL_300
  LEVEL_400
  LEVEL_500
  LEVEL_600
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  EXPIRED
  ARCHIVED
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ResourceType {
  NOTE
  SLIDE
  PAST_QUESTION
  LINK
  OTHER
}

enum MaterialStatus {
  PENDING
  READY
  FAILED
  ARCHIVED
}

enum DiagnosticStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum NotificationType {
  DEADLINE
  STUDY_PLAN
  GROUP
  SYSTEM
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  LAB
  PROJECT
  MIDSEM
  EXAM
  OTHER
}

enum GoalCategory {
  ACADEMIC
  STUDY_TIME
  COURSE_MASTERY
  TASKS
  PERSONAL
}

enum GoalMetric {
  MANUAL
  CWA
  STUDY_MINUTES
  TASKS_COMPLETED
  ASSESSMENT_AVERAGE
}

enum GoalPeriod {
  SEMESTER
  WEEKLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum UserRole {
  STUDENT
  ADMIN
}

enum AdminRoleAction {
  BOOTSTRAPPED
  GRANTED
  REVOKED
}

enum CourseApprovalStatus {
  OFFICIAL
  PENDING
  REJECTED
}

enum PlatformMaterialStatus {
  PUBLISHED
  ARCHIVED
  FAILED
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum FeedbackType {
  BUG
  IDEA
  PRAISE
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  PLANNED
  CLOSED
}

model User {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId             String                   @unique @map("auth_user_id") @db.Uuid
  email                  String                   @unique
  role                   UserRole                 @default(STUDENT)
  fullName               String                   @map("full_name")
  studentId              String?                  @unique @map("student_id")
  college                String?
  programme              String?
  department             String?
  level                  AcademicLevel?
  cwa                    Decimal?                 @db.Decimal(5, 2)
  activeSemesterId       String?                  @map("active_semester_id") @db.Uuid
  avatarUrl              String?                  @map("avatar_url")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")
  deletionStoragePaths   Json?                    @map("deletion_storage_paths")
  deletionStoragePending Boolean                  @default(false) @map("deletion_storage_pending")
  deletionAuthPending    Boolean                  @default(false) @map("deletion_auth_pending")
  deletionAttempts       Int                      @default(0) @map("deletion_attempts")
  deletionLastError      String?                  @map("deletion_last_error")
  deletionCompletedAt    DateTime?                @map("deletion_completed_at")
  activeSemester         Semester?                @relation("UserActiveSemester", fields: [activeSemesterId], references: [id])
  aiConversations        AiConversation[]
  assessments            Assessment[]
  cwaSnapshots           CwaSnapshot[]
  enrollments            Enrollment[]
  goals                  Goal[]
  goalProgressSnapshots  GoalProgressSnapshot[]
  groupsOwned            StudyGroup[]             @relation("StudyGroupOwner")
  memberships            StudyGroupMember[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  resources              Resource[]
  courseMaterials        CourseMaterial[]
  diagnosticAttempts     DiagnosticAttempt[]
  diagnosticQuizzes      DiagnosticQuiz[]
  topicMasteries         TopicMastery[]
  semesterProfiles       SemesterProfile[]
  semestersOwned         Semester[]               @relation("UserSemesters")
  studyPlans             StudyPlan[]
  tasks                  Task[]
  timetable              TimetableBlock[]
  weakAreas              WeakArea[]
  peerQuestions          PeerQuestion[]
  peerAnswers            PeerAnswer[]
  peerVotes              PeerQuestionVote[]
  platformMaterials      PlatformCourseMaterial[]
  programmeCourseExclusions ProgrammeCourseExclusion[]
  adminRoleChangesMade   AdminRoleAudit[]         @relation("AdminRoleAuditActor")
  adminRoleChangesReceived AdminRoleAudit[]        @relation("AdminRoleAuditTarget")
  coursesCreated          Course[]                 @relation("CourseCreator")
  supportRequests         SupportRequest[]
  feedback                Feedback[]

  @@index([activeSemesterId])
  @@index([deletedAt])
  @@index([deletionStoragePending, deletionAuthPending])
  @@map("users")
}

model SupportRequest {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  subject   String
  message   String
  status    SupportRequestStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("support_requests")
}

model Feedback {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      FeedbackType   @default(OTHER)
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("feedback")
}

model AdminRoleAudit {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?         @map("actor_id") @db.Uuid
  targetUserId String          @map("target_user_id") @db.Uuid
  action       AdminRoleAction
  createdAt    DateTime        @default(now()) @map("created_at")
  actor        User?           @relation("AdminRoleAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User            @relation("AdminRoleAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorId])
  @@map("admin_role_audits")
}

model Course {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                   @unique
  name              String
  creditHours       Int?                     @map("credit_hours")
  department        String?
  level             AcademicLevel?
  description       String?
  approvalStatus    CourseApprovalStatus     @default(PENDING) @map("approval_status")
  createdById       String?                  @map("created_by_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  createdBy         User?                    @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assessments       Assessment[]
  enrollments       Enrollment[]
  goals             Goal[]
  groups            StudyGroup[]
  resources         Resource[]
  studyItems        StudyPlanItem[]
  tasks             Task[]
  timetable         TimetableBlock[]
  weakAreas         WeakArea[]
  peerQuestions     PeerQuestion[]
  platformMaterials PlatformCourseMaterial[]
  platformTopics    PlatformCourseTopic[]

  @@map("courses")
  @@index([approvalStatus, createdById])
}

model Semester {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String            @map("owner_id") @db.Uuid
  level           AcademicLevel
  term            SemesterTerm
  name            String
  academicYear    String            @map("academic_year")
  cwa             Decimal?          @db.Decimal(5, 2)
  startDate       DateTime?         @map("start_date") @db.Date
  endDate         DateTime?         @map("end_date") @db.Date
  isActive        Boolean           @default(false) @map("is_active")
  isArchived      Boolean           @default(false) @map("is_archived")
  archivedAt      DateTime?         @map("archived_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  owner           User              @relation("UserSemesters", fields: [ownerId], references: [id], onDelete: Cascade)
  assessments     Assessment[]
  cwaSnapshots    CwaSnapshot[]
  activeUsers     User[]            @relation("UserActiveSemester")
  aiConversations AiConversation[]
  enrollments     Enrollment[]
  goals           Goal[]
  goalProgressSnapshots GoalProgressSnapshot[]
  groups          StudyGroup[]
  profiles        SemesterProfile[]
  studyPlans      StudyPlan[]
  tasks           Task[]
  timetable       TimetableBlock[]
  weakAreas       WeakArea[]
  peerQuestions   PeerQuestion[]
  notifications   Notification[]

  @@unique([ownerId, level, term])
  @@index([ownerId])
  @@index([ownerId, isArchived])
  @@map("semesters")
}

model SemesterProfile {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  semesterId String         @map("semester_id") @db.Uuid
  level      AcademicLevel?
  cwa        Decimal?       @db.Decimal(5, 2)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  semester   Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, semesterId])
  @@index([semesterId])
  @@map("semester_profiles")
}

model Enrollment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  courseId          String           @map("course_id") @db.Uuid
  semesterId        String           @map("semester_id") @db.Uuid
  lecturer          String?
  currentGrade      String?          @map("current_grade")
  attendance        Decimal?         @db.Decimal(5, 2)
  confidenceScore   Decimal?         @map("confidence_score") @db.Decimal(5, 2)
  createdAt         DateTime         @default(now()) @map("created_at")
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester          Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiConversations   AiConversation[]
  courseMaterials   CourseMaterial[]
  courseTopics      CourseTopic[]
  diagnosticQuizzes DiagnosticQuiz[]
  topicMasteries    TopicMastery[]

  @@unique([userId, courseId, semesterId])
  @@index([courseId])
  @@index([semesterId])
  @@map("enrollments")
}

model Assessment {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  semesterId String         @map("semester_id") @db.Uuid
  courseId   String         @map("course_id") @db.Uuid
  title      String
  type       AssessmentType @default(OTHER)
  score      Decimal        @db.Decimal(7, 2)
  maxScore   Decimal        @map("max_score") @db.Decimal(7, 2)
  weight     Decimal?       @db.Decimal(5, 2)
  assessedAt DateTime?      @map("assessed_at") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester   Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, courseId])
  @@index([semesterId])
  @@map("assessments")
}

model CwaSnapshot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  cwa        Decimal  @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, recordedAt])
  @@index([semesterId])
  @@map("cwa_snapshots")
}

model Goal {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  semesterId   String       @map("semester_id") @db.Uuid
  courseId     String?      @map("course_id") @db.Uuid
  title        String
  category     GoalCategory
  metric       GoalMetric   @default(MANUAL)
  period       GoalPeriod   @default(SEMESTER)
  targetValue  Decimal      @map("target_value") @db.Decimal(10, 2)
  currentValue Decimal      @default(0) @map("current_value") @db.Decimal(10, 2)
  deadline     DateTime?    @db.Date
  status       GoalStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  course       Course?      @relation(fields: [courseId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressSnapshots GoalProgressSnapshot[]

  @@index([userId, semesterId, status])
  @@index([semesterId])
  @@index([courseId])
  @@map("goals")
}

model GoalProgressSnapshot {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  semesterId   String     @map("semester_id") @db.Uuid
  goalId       String     @map("goal_id") @db.Uuid
  metric       GoalMetric
  currentValue Decimal    @map("current_value") @db.Decimal(10, 2)
  targetValue  Decimal    @map("target_value") @db.Decimal(10, 2)
  progress     Int
  source       String     @default("computed")
  recordedAt   DateTime   @default(now()) @map("recorded_at")
  goal         Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  semester     Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
  @@index([userId, semesterId, recordedAt])
  @@map("goal_progress_snapshots")
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  courseId    String?      @map("course_id") @db.Uuid
  semesterId  String       @map("semester_id") @db.Uuid
  title       String
  description String?
  dueAt       DateTime?    @map("due_at")
  reminderAt  DateTime?    @map("reminder_at")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course?      @relation(fields: [courseId], references: [id])
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dueAt])
  @@index([reminderAt])
  @@index([userId, semesterId, status])
  @@index([semesterId])
  @@map("tasks")
}

model TimetableBlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  courseId   String?  @map("course_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week")
  startTime  DateTime @map("start_time") @db.Time
  endTime    DateTime @map("end_time") @db.Time
  venue      String?
  isBusy     Boolean  @default(true) @map("is_busy")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course?  @relation(fields: [courseId], references: [id])
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, dayOfWeek])
  @@index([semesterId])
  @@map("timetable_blocks")
}

model StudyPlan {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  semesterId    String          @map("semester_id") @db.Uuid
  title         String
  status        StudyPlanStatus @default(DRAFT)
  generatedByAi Boolean         @default(false) @map("generated_by_ai")
  startDate     DateTime?       @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  items         StudyPlanItem[]
  semester      Semester        @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, status])
  @@index([semesterId])
  @@map("study_plans")
}

model StudyPlanItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyPlanId     String     @map("study_plan_id") @db.Uuid
  courseId        String?    @map("course_id") @db.Uuid
  title           String
  scheduledStart  DateTime?  @map("scheduled_start")
  durationMinutes Int?       @map("duration_minutes")
  status          TaskStatus @default(TODO)
  aiReason        String?    @map("ai_reason")
  createdAt       DateTime   @default(now()) @map("created_at")
  course          Course?    @relation(fields: [courseId], references: [id])
  studyPlan       StudyPlan  @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId])
  @@map("study_plan_items")
}

model WeakArea {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  semesterId     String   @map("semester_id") @db.Uuid
  topic          String
  weaknessScore  Decimal? @map("weakness_score") @db.Decimal(5, 2)
  detectedFrom   String?  @map("detected_from")
  recommendation String?
  updatedAt      DateTime @updatedAt @map("updated_at")
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester       Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId, courseId])
  @@index([semesterId])
  @@map("weak_areas")
}

model PeerQuestion {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  semesterId String             @map("semester_id") @db.Uuid
  courseId   String?            @map("course_id") @db.Uuid
  title      String
  body       String
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  answers    PeerAnswer[]
  author     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester   Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  votes      PeerQuestionVote[]

  @@index([semesterId, createdAt])
  @@index([courseId])
  @@index([userId])
  @@map("peer_questions")
}

model PeerAnswer {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  body       String
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  author     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   PeerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
  @@index([userId])
  @@map("peer_answers")
}

model PeerQuestionVote {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  question   PeerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId])
  @@map("peer_question_votes")
}

model StudyGroup {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  courseId     String             @map("course_id") @db.Uuid
  semesterId   String             @map("semester_id") @db.Uuid
  ownerId      String             @map("owner_id") @db.Uuid
  maxMembers   Int                @default(10) @map("max_members")
  meetingAt    DateTime?          @map("meeting_at")
  meetingPlace String?            @map("meeting_place")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members      StudyGroupMember[]
  owner        User               @relation("StudyGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  semester     Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([semesterId, courseId])
  @@index([ownerId])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String     @map("group_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     String     @default("member")
  joinedAt DateTime   @default(now()) @map("joined_at")
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("study_group_members")
}

model Resource {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId   String       @map("course_id") @db.Uuid
  title      String
  fileUrl    String?      @map("file_url")
  linkUrl    String?      @map("link_url")
  type       ResourceType @default(OTHER)
  uploadedBy String?      @map("uploaded_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader   User?        @relation(fields: [uploadedBy], references: [id])

  @@index([courseId])
  @@map("resources")
}

model CourseTopic {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId        String               @map("enrollment_id") @db.Uuid
  title               String
  description         String?
  sequence            Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  enrollment          Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chunks              MaterialChunk[]
  diagnosticQuestions DiagnosticQuestion[]
  topicMasteries      TopicMastery[]

  @@unique([enrollmentId, title])
  @@index([enrollmentId, sequence])
  @@map("course_topics")
}

model DiagnosticQuiz {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  enrollmentId String               @map("enrollment_id") @db.Uuid
  title        String
  status       DiagnosticStatus     @default(READY)
  blueprint    Json
  score        Int?
  maxScore     Int?                 @map("max_score")
  model        String?
  startedAt    DateTime?            @map("started_at")
  completedAt  DateTime?            @map("completed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions    DiagnosticQuestion[]

  @@index([userId, createdAt])
  @@index([enrollmentId, status])
  @@map("diagnostic_quizzes")
}

model DiagnosticQuestion {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId        String              @map("quiz_id") @db.Uuid
  topicId       String?             @map("topic_id") @db.Uuid
  platformTopicId String?           @map("platform_topic_id") @db.Uuid
  position      Int
  prompt        String
  options       Json
  correctAnswer String              @map("correct_answer")
  explanation   String
  difficulty    QuestionDifficulty  @default(MEDIUM)
  sourceRefs    Json?               @map("source_refs")
  createdAt     DateTime            @default(now()) @map("created_at")
  quiz          DiagnosticQuiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic         CourseTopic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  platformTopic PlatformCourseTopic? @relation(fields: [platformTopicId], references: [id], onDelete: Cascade)
  attempts      DiagnosticAttempt[]

  @@unique([quizId, position])
  @@index([topicId])
  @@index([platformTopicId])
  @@map("diagnostic_questions")
}

model DiagnosticAttempt {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId     String             @map("question_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  selectedAnswer String             @map("selected_answer")
  isCorrect      Boolean            @map("is_correct")
  answeredAt     DateTime           @default(now()) @map("answered_at")
  question       DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId, answeredAt])
  @@map("diagnostic_attempts")
}

model TopicMastery {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  enrollmentId String      @map("enrollment_id") @db.Uuid
  topicId      String?     @map("topic_id") @db.Uuid
  platformTopicId String?  @map("platform_topic_id") @db.Uuid
  attemptCount Int         @default(0) @map("attempt_count")
  correctCount Int         @default(0) @map("correct_count")
  masteryScore Decimal     @default(0) @map("mastery_score") @db.Decimal(5, 2)
  updatedAt    DateTime    @updatedAt @map("updated_at")
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic        CourseTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  platformTopic PlatformCourseTopic? @relation(fields: [platformTopicId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, enrollmentId, topicId])
  @@unique([userId, enrollmentId, platformTopicId])
  @@index([enrollmentId, masteryScore])
  @@index([platformTopicId])
  @@map("topic_masteries")
}

model CourseMaterial {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId     String          @map("enrollment_id") @db.Uuid
  uploadedBy       String          @map("uploaded_by") @db.Uuid
  title            String
  type             ResourceType    @default(OTHER)
  sourceUrl        String?         @map("source_url")
  storagePath      String?         @map("storage_path")
  originalFileName String?         @map("original_file_name")
  mimeType         String?         @map("mime_type")
  fileSize         Int?            @map("file_size")
  contentHash      String?         @map("content_hash")
  status           MaterialStatus  @default(PENDING)
  errorMessage     String?         @map("error_message")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  enrollment       Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  uploader         User            @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  chunks           MaterialChunk[]

  @@index([enrollmentId, status, updatedAt])
  @@index([uploadedBy])
  @@unique([enrollmentId, contentHash])
  @@map("course_materials")
}

model MaterialChunk {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String         @map("material_id") @db.Uuid
  topicId    String?        @map("topic_id") @db.Uuid
  chunkIndex Int            @map("chunk_index")
  content    String
  pageLabel  String?        @map("page_label")
  charCount  Int            @map("char_count")
  createdAt  DateTime       @default(now()) @map("created_at")
  material   CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  topic      CourseTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([materialId, chunkIndex])
  @@index([topicId])
  @@map("material_chunks")
}

model PlatformCourseTopic {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String                   @map("course_id") @db.Uuid
  title       String
  description String?
  learningOutcomes String?                 @map("learning_outcomes")
  sequence    Int                      @default(0)
  isArchived  Boolean                  @default(false) @map("is_archived")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials   PlatformCourseMaterial[]
  materialLinks PlatformMaterialTopic[]
  chunks      PlatformMaterialChunk[]
  diagnosticQuestions DiagnosticQuestion[]
  topicMasteries TopicMastery[]

  @@unique([courseId, title])
  @@index([courseId, sequence])
  @@map("platform_course_topics")
}

model PlatformCourseMaterial {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId         String                  @map("course_id") @db.Uuid
  topicId          String?                 @map("topic_id") @db.Uuid
  uploadedBy       String                  @map("uploaded_by") @db.Uuid
  title            String
  type             ResourceType            @default(OTHER)
  storagePath      String?                 @map("storage_path")
  originalFileName String?                 @map("original_file_name")
  mimeType         String?                 @map("mime_type")
  fileSize         Int?                    @map("file_size")
  sourceUrl        String?                 @map("source_url")
  contentHash      String?                 @map("content_hash")
  status           PlatformMaterialStatus  @default(PUBLISHED)
  errorMessage     String?                 @map("error_message")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic            PlatformCourseTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  uploader         User                    @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  chunks           PlatformMaterialChunk[]
  topicLinks       PlatformMaterialTopic[]

  @@index([courseId, status, updatedAt])
  @@index([topicId])
  @@unique([courseId, contentHash])
  @@map("platform_course_materials")
}

model PlatformMaterialChunk {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String                 @map("material_id") @db.Uuid
  topicId    String?                @map("topic_id") @db.Uuid
  chunkIndex Int                    @map("chunk_index")
  content    String
  charCount  Int                    @map("char_count")
  createdAt  DateTime               @default(now()) @map("created_at")
  material   PlatformCourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  topic      PlatformCourseTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([materialId, chunkIndex])
  @@index([topicId])
  @@map("platform_material_chunks")
}

model PlatformMaterialTopic {
  materialId String                 @map("material_id") @db.Uuid
  topicId    String                 @map("topic_id") @db.Uuid
  createdAt  DateTime               @default(now()) @map("created_at")
  material   PlatformCourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  topic      PlatformCourseTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([materialId, topicId])
  @@index([topicId])
  @@map("platform_material_topics")
}

model ProgrammeCourseExclusion {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  college      String
  programme    String
  department   String
  level        AcademicLevel
  semester     String
  courseCode   String        @map("course_code")
  removedById  String        @map("removed_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  removedBy    User          @relation(fields: [removedById], references: [id], onDelete: Restrict)

  @@unique([programme, level, semester, courseCode])
  @@index([programme, level, semester])
  @@index([removedById])
  @@map("programme_course_exclusions")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  semesterId String?          @map("semester_id") @db.Uuid
  title      String
  message    String
  type       NotificationType @default(SYSTEM)
  actionUrl  String?          @map("action_url")
  sourceKey  String?          @map("source_key")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  semester   Semester?        @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, isRead, createdAt])
  @@index([semesterId])
  @@map("notifications")
}

model NotificationPreference {
  userId                      String    @id @map("user_id") @db.Uuid
  taskDeadlines               Boolean   @default(true) @map("task_deadlines")
  studySessions               Boolean   @default(true) @map("study_sessions")
  groupUpdates                Boolean   @default(true) @map("group_updates")
  goalDeadlines               Boolean   @default(true) @map("goal_deadlines")
  qaAnswers                   Boolean   @default(true) @map("qa_answers")
  reminderHours               Int       @default(24) @map("reminder_hours")
  studySessionReminderMinutes Int       @default(15) @map("study_session_reminder_minutes")
  lastSyncedAt                DateTime? @map("last_synced_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
